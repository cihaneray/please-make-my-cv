# ==============================================================================
# Best-Practice .gitignore for CV Workspace
# Technologies: Python (FastAPI, uv, pytest, ruff) + Node.js (Next.js, TypeScript)
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System & Filesystem Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# Environment, Credentials & Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.env
*.env.*
!.env.example

# ------------------------------------------------------------------------------
# Python (FastAPI, uv, pytest, ruff, mypy)
# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd

# C extensions
*.so

# Distribution / packaging
build/
dist/
downloads/
eggs/
.eggs/
/lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Package managers (uv, pip, pipenv)
.uv/
pip-log.txt
pip-delete-this-directory.txt

# Unit test & coverage artifacts
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.tox/
.nox/

# Linters & Type Checkers
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/
.dmypy.json
dmypy.json

# Databases & SQLite WAL/Journal files
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
cv_workspace.db

# ------------------------------------------------------------------------------
# Node.js & Next.js (Web Frontend)
# ------------------------------------------------------------------------------
# Dependency directories
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnpm-store/

# Next.js build output
.next/
out/

# Turbopack & build caches
.turbo/
*.tsbuildinfo
next-env.d.ts.bak

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Frontend test & coverage
coverage/
.nyc_output/

# ------------------------------------------------------------------------------
# IDEs, Editors & Developer Tools
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (PyCharm, WebStorm, IntelliJ)
.idea/
*.iws
*.iml
*.ipr

# Other editors
*.swp
*.swo
*.bak
*~
.#*

# AI Assistant scratchpads & vendor files
.gemini/
AGENTS.md
CLAUDE.md

# Documentation & Reference artifacts
Docs/*
!Docs/api.md
!Docs/architecture.md


!**/.env.example
test-results/
playwright-report/
output/
tmp/

.next-e2e/

# Backend-only LLM credentials
**/ai-settings.json
**/.ai-settings-*.tmp

**/e2e-ai-settings.json
**/ai-settings.key
**/e2e-ai-settings.key
**/.private-*.tmp
