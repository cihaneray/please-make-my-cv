FROM node:20-bookworm-slim AS node_runtime

# Compose supplies the same Python/Chromium image used by development.
FROM api_runtime
COPY --from=node_runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node_runtime /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && ln -s /app /api
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci && npx playwright install --only-shell chromium
COPY apps/web/ ./
COPY packages/ /packages/
COPY scripts/verify-container.sh /verify-container.sh
WORKDIR /app
CMD ["sh", "/verify-container.sh"]
